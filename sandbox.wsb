<!--
Windows Sandbox 配置文件
使用方式: 双击 sandbox.wsb 即可启动隔离环境
需要: Windows 10/11 Pro 或 Enterprise

Sandbox 会在一个干净的临时 Windows 环境中运行：
- 你的主电脑完全不受影响，可以正常处理工作
- 微信 + Bot 在沙盒内运行
- 关闭沙盒后所有数据自动清除（或映射文件夹保留）
-->
<Configuration>
  <VGpu>Enable</VGpu>
  <Networking>Enable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <ProtectedClient>Disable</ProtectedClient>
  <MemoryInMB>4096</MemoryInMB>

  <!-- 映射项目文件夹到沙盒桌面(只读)，方便安装依赖 -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\28708\wechat-ai-bot</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\wechat-ai-bot</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>

  <!-- 沙盒启动后自动执行的命令 -->
  <LogonCommand>
    <Command>C:\Windows\System32\cmd.exe /c "cd /d C:\Users\WDAGUtilityAccount\Desktop\wechat-ai-bot && echo 沙盒已启动 — 请安装微信 + 运行 setup.bat + 启动 Bot"</Command>
  </LogonCommand>
</Configuration>
