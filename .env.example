# ============================================
# 微信 AI Bot — 配置模板
# 复制为 .env 并填入你的配置
# ============================================

# -------- LLM（必填）--------
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.8

# -------- 回复策略 --------
REPLY_MIN_DELAY=1.0
REPLY_MAX_DELAY=5.0
SKIP_REPLY_PROBABILITY=0.05
REPLY_COOLDOWN=30

# -------- 人格描述 --------
PERSONALITY_PROFILE=一个随和的年轻人，说话简洁幽默，回复简短不爱长篇大论

# -------- 监控目标 (可选，在Web UI中配置更方便) --------
GROUP_LIST=
CONTACT_LIST=
BOT_NAME=

# -------- Web UI --------
WEB_PASSWORD=
WEB_PORT=7860
